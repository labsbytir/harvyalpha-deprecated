[Unit]
Description=Harvy telegram queue consumer (slot %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/harvy
EnvironmentFile=/opt/harvy/.env
ExecStart=/opt/harvy/.venv/bin/python -u /opt/harvy/scripts/telegram_consumer_loop.py --slot %i
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
