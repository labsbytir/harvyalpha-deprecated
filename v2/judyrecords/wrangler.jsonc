{
  // Replace placeholder resource IDs and review the target Worker before any non-dry-run deploy.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "harvy-judyrecords",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "V2_DB",
      "database_name": "harvy-v2",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "V2_BUCKET", "bucket_name": "harvy-v2" }
  ],
  "k2": [
    { "binding": "V2_EVENTS", "stream": "e8073c59caed4ee193cd995aa457b21a" }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "harvy-v2-records",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "harvy-v2-records-dlq"
      }
    ]
  }
}
