{
  "private": true,
  "scripts": {
    "build:auth-client": "vite build --config auth/vite.config.mts",
    "build:graph": "vite build --config v2/graph/vite.config.mts",
    "typecheck:auth": "tsc -p auth/tsconfig.json",
    "typecheck:auth-client": "tsc -p auth/tsconfig.client.json",
    "test:auth-consent": "node --experimental-strip-types --test auth/privacy-consent.test.mjs",
    "test:v2": "node --experimental-strip-types --test v2/tests/contracts.test.mjs",
    "typecheck:v2": "tsc -p v2/tsconfig.json",
    "typecheck:graph": "tsc -p v2/graph/tsconfig.json",
    "build:templates": "tsc -p tsconfig.json && npm run typecheck:auth && npm run typecheck:auth-client && npm run build:auth-client && npm run typecheck:graph && npm run build:graph && python3 scripts/sync_worker_modules.py && python3 scripts/build_templates.py",
    "deploy:auth": "npx wrangler deploy --config auth/wrangler.jsonc",
    "deploy": "npm run build:templates && npm run deploy:auth && npx wrangler deploy",
    "sync:vault-guides": "python3 scripts/sync_vault_guides.py",
    "changelog": "conventional-changelog -i CHANGELOG.md -s -t v -p angular",
    "prepare": "husky",
    "sync:worker-modules": "python3 scripts/sync_worker_modules.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "conventional-changelog-cli": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.13",
    "@better-auth/infra": "^0.4.22",
    "@better-auth/passkey": "^1.7.13",
    "@better-auth/stripe": "^1.7.13",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@marinedotsh/better-auth-referral": "^0.3.0",
    "@mui/material": "^6.5.0",
    "@mui/x-charts": "^7.29.1",
    "@nivo/core": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "better-auth": "^1.7.13",
    "better-auth-cloudflare": "^0.4.1",
    "drizzle-cube": "^0.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.3.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  }
}
